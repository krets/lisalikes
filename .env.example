# Generate with: openssl rand -hex 32
JWT_SECRET=
ADMIN_SECRET=

# Path segment for the hidden admin panel, e.g. https://yourdomain.com/api/<this>
# Generate with: openssl rand -hex 8 — keep this out of version control and don't reuse it elsewhere
ADMIN_PATH=

# From https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://yourdomain.com/api/admin/spotify/callback

APP_DOMAIN=https://yourdomain.com

SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
